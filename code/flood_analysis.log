  3. sum `var' if year==1925 [aweight=county_w]
  4. eststo, add(mean_ `r(mean)' sd_ -1*`r(sd)')
  5. reg ln`var' flood_intensity d_s_* cotton_s_* corn_s_* ld_* dx_* dy_* rug_*    if year==1925 [aweight=county_w], robu
> st
  6. sum `var' if year==1925 [aweight=county_w]
  7. eststo, add(mean_ `r(mean)' sd_ -1*`r(sd)')
  8. reg ln`var'_d flood_intensity d_s_* if year==1925 [aweight=county_w], robust
  9. sum `var' if year==1925 [aweight=county_w]
