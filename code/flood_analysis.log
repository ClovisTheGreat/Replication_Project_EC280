. *In migration data

. clear

. use preanalysis.dta

. tsset fips year

Panel variable: fips (strongly balanced)
 Time variable: year, 1900 to 1970, but with gaps
         Delta: 1 unit

. replace people = L10.people if year ==1930 /*use 1920 population*/
1930/ invalid name
r(198);

. foreach j in  white black{
  2. replace people_`j' = L10.people_`j' if year ==1930 /*use 1920 population*/
  3. }
1930/ invalid name
r(198);

. foreach i in county{ 
  2. gen in_migrate_`i' = (in_people - in_same`i') / people
  3. replace in_migrate_`i' = 0 if people==0
  4. reg in_migrate_`i' f_int_1930   d_sy_* [aweight=people], robust
  5. sum in_migrate_`i' [aweight=people] if f_int_1930 == 0
  6. eststo, add(mean_ `r(mean)' sd_ -1*`r(sd)')
  7. }
