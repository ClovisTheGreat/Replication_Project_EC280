. eststo clear

. foreach i in county state region { 
  2. gen migrate_`i' = (people - same`i') / people
  3. replace migrate_`i' = 0 if people==0
  4. reg migrate_`i' f_int_1920   d_sy_* [aweight=people], robust
  5. sum migrate_`i' [aweight=people] if f_int_1920 == 0
  6. eststo, add(mean_ `r(mean)' sd_ -1*`r(sd)')
  7. }
