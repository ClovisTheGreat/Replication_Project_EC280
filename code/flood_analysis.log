. foreach j in black white {
  2. foreach i in county state region { 
  3. gen migrate_`i'_`j' = (people_`j' - same`i'_`j') / people_`j'
  4. replace migrate_`i'_`j' = 0 if people_`j'==0
  5. reg migrate_`i'_`j' f_int_1920    d_sy_* [aweight=people_`j'], robust
  6. sum migrate_`i'_`j' if f_int_1920 == 0 [aweight=people_`j']
  7. eststo, add(mean_ `r(mean)' sd_ -1*`r(sd)')
  8. }
  9. }
